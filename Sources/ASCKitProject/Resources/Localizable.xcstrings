    "Write one, or the store shows this language the group's name from another language." : {
      "comment" : "Fix in the problem list about a subscription group with no display name in one language."
    },
    "Written again with no alpha channel:" : {
      "comment" : "Heading in the report of the action that removes the alpha channel from screenshots. A list of file names comes after it."
