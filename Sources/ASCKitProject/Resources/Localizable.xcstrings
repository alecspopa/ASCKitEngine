    "Nothing to add." : {
      "comment" : "Report of an action that adds languages or device classes, when it added nothing."
    },
    "Nothing to change." : {
      "comment" : "Error sentence when a push of text has nothing to change."
    },
    "Nothing to change. App Store Connect already matches these files." : {
      "comment" : "Line in the publish plan when there is nothing to publish. Do not translate App Store Connect."
    },
    "Nothing to clear." : {
      "comment" : "Report of the action that removes the alpha channel from screenshots, when it changed nothing."
    },
    "Nothing to fill." : {
      "comment" : "Report after a read when no language has an empty field that App Store Connect can fill."
    },
    "Nothing to upload." : {
      "comment" : "Report of a push of screenshots, when it uploaded nothing."
    },
    "Nothing to write." : {
      "comment" : "Report of a push or of a read into files, when it wrote nothing."
    },
    "Nothing uploads them." : {
      "comment" : "Second sentence of a warning about previews in a folder no device class matches."
    },
    "Nothing uploads them. List the device class in asckit.json, or remove the folder." : {
      "comment" : "Fix text for a problem in the problem list. Keep asckit.json as it is, because it is a file name.",
      "localizations" : {
