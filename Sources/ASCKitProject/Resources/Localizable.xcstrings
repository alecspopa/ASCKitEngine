              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Silenced %arg warning in %2$@. It is in %3$@."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Silenced %arg warnings in %2$@. They are in %3$@."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Silenced %lld warnings in every version. They are in %@." : {
      "comment" : "asckit silence --all prints this in the terminal. The count is the number of warnings about in-app purchases. The value is a file path, such as products/silenced.json.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@arg1@"
