    },
    "The app information is not editable. The name and the subtitle are fixed until a new version is in Prepare for Submission." : {
      "comment" : "Reason in the publish plan that app information cannot change. Do not translate Prepare for Submission. It is a state name in App Store Connect."
    },
    "The app is built in %@, and the listing has no %@." : {
      "comment" : "Problem message in the problem list. The first value is a language code from the Xcode project. The second is a language code for the App Store listing.",
      "localizations" : {
