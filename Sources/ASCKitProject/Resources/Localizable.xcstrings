    "Subscription groups:" : {
      "comment" : "Heading in the publish plan, shown as fixed-width text. A list of subscription group text changes comes after it."
    },
    "Subtitle" : {
      "comment" : "Noun. The name of the subtitle field of the listing."
    },
    "Support URL" : {
      "comment" : "Noun. The name of the support URL field of the listing. URL is a web address."
    },
    "Take %@ out of ignoredLocales. Every other language is translated from it." : {
      "comment" : "How to fix an error about the configuration file. The value is a language code. Do not translate ignoredLocales, which is a key in the file."
    },
    "Take it out of usesSourceCreative." : {
      "comment" : "How to fix a problem in the problem list. Do not translate usesSourceCreative. It is a JSON key."
    },
    "Take it out of usesSourceScreenshots. Every other language falls back to this one." : {
      "comment" : "Fix in the problem list about the source language. Do not translate usesSourceScreenshots. It is a JSON key. The word it refers to the source language."
    },
    "Take it out. Only a subscription has customers who already pay." : {
      "comment" : "Fix in the problem list. The word it refers to preserveCurrentPrice, which is a JSON key. Customers who already pay are current subscribers."
    },
    "Take subscriptionGroup out. Only an auto-renewable subscription has one." : {
      "comment" : "Fix in the problem list. Do not translate subscriptionGroup. It is a JSON key. The word one refers to a subscription group."
    },
    "Text:" : {
      "comment" : "Heading in the publish plan, shown as fixed-width text. A list of changes to the text of the listing comes after it."
    },
    "The %@ %@ screenshots are newer than the %@ ones. Copying brings %lld screenshots across." : {
      "comment" : "One line in the offer to copy screenshots from a related language. The first and the third values are language codes. The second is a device class name. The count is the number of screenshots to copy.",
