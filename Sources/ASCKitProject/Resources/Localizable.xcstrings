    },
    "6 months" : {
      "comment" : "Name of a subscription period, which is the time between two payments."
    },
    "A header or search results video runs 5 to 30 seconds." : {
      "comment" : "How to fix a header or search results video of the wrong length."
    },
    "A page can use only the keywords of the version on sale. Take it off, or wait until a version with it is on sale." : {
      "comment" : "Fix for a custom product page keyword that the version on sale does not have."
    },
    "A price point belongs to one product in one country. Take this one out, or set an amount instead and let ASCKit find the point." : {
      "comment" : "Fix in the problem list. A price point is one fixed price on the list of prices of the App Store. Do not translate ASCKit."
    },
    "A product id cannot be empty." : {
      "comment" : "Error sentence when a person names a new in-app purchase."
    },
    "A product id cannot hold a slash or a colon, because it is the file name." : {
      "comment" : "Error sentence when a person names a new in-app purchase. The product id is also the name of its file."
    },
    "A product id cannot start with a dot, because the file would be hidden." : {
      "comment" : "Error sentence when a person names a new in-app purchase. A file name that starts with a dot is hidden."
    },
    "A screenshot taken off a set stays in the app's asset library." : {
      "comment" : "Note in the publish sheet. Removing a screenshot from a set does not delete the file from App Store Connect."
    },
    "A set takes at most %lld app previews. Nothing was added." : {
      "comment" : "Refusal when a set would hold too many app previews. The count is the most a set takes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A set takes at most %lld app preview. Nothing was added."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A set takes at most %lld app previews. Nothing was added."
                }
              }
            }
          }
        }
      }
    },
    "A subscription group name cannot be empty." : {
      "comment" : "Reason a subscription group file cannot be written."
    },
    "A subscription group name cannot hold a slash or a colon, because it is the file name." : {
      "comment" : "Reason a subscription group file cannot be written."
    },
    "A subscription group name cannot start with a dot, because the file would be hidden." : {
      "comment" : "Reason a subscription group file cannot be written."
    },
    "ASCKit cannot read %@. It records what this project uploaded to App Store Connect. Fix the file, or take it back from git. ASCKit does not write over it." : {
      "comment" : "Error when the record of uploads is damaged. The value is a file path. Do not translate ASCKit, App Store Connect or git."
    },
    "ASCKit cannot read %@/%@." : {
      "comment" : "Problem in a check. The values are a folder path and the file poster-frames.json. Do not translate ASCKit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ASCKit cannot read %1$@/%2$@."
          }
        }
      }
    },
    "ASCKit could not read %@, so it did not upload it." : {
      "comment" : "Push failure. The value is a screenshot file name. Do not translate ASCKit."
    },
    "ASCKit does not know what %@ is for." : {
      "comment" : "Warning in a check. The value is a file name. Do not translate ASCKit."
    },
    "ASCKit has no price for %@ in %@ and other countries. App Store Connect would choose those prices itself, so no price goes until each of them has one. Use a base price that App Store Connect allows, or set those countries by hand." : {
      "comment" : "Reason in the publish plan that the prices of a product cannot be published. The first value is a product id. The second is a list of the first ten country or region codes, such as DEU, FRA and ITA. More countries have no price. Do not translate ASCKit or App Store Connect.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ASCKit has no price for %1$@ in %2$@ and other countries. App Store Connect would choose those prices itself, so no price goes until each of them has one. Use a base price that App Store Connect allows, or set those countries by hand."
          }
        }
      }
    },
    "ASCKit has no price for %@ in %@. App Store Connect would choose those prices itself, so no price goes until each of them has one. Use a base price that App Store Connect allows, or set those countries by hand." : {
      "comment" : "Reason in the publish plan that the prices of a product cannot be published. The first value is a product id. The second is a list of country or region codes, such as DEU, FRA and ITA. Do not translate ASCKit or App Store Connect.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ASCKit has no price for %1$@ in %2$@. App Store Connect would choose those prices itself, so no price goes until each of them has one. Use a base price that App Store Connect allows, or set those countries by hand."
          }
        }
      }
    },
    "Accepted sizes are %@, or the same pair swapped for landscape." : {
      "comment" : "Fix in the problem list. The value is a list of screenshot sizes in pixels, such as 1290x2796. Landscape is the wide orientation of the screen."
    },
    "Add %@ to deviceClasses, or delete the folder. It will not be published." : {
      "comment" : "Fix in the problem list. The value is a device class id. Do not translate deviceClasses. It is a JSON key."
    },
    "Add %@ to locales, or take %@ out of the Xcode project." : {
      "comment" : "Fix in the problem list. The first value is a language code. The second is a language code from the Xcode project, such as de. Do not translate locales, which is a JSON key.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add %1$@ to locales, or take %2$@ out of the Xcode project."
          }
        }
      }
    },
    "Add %@ to locales, or take it out of ignoredLocales. A language is ignored by staying in the list and being named here." : {
      "comment" : "How to fix a warning about the configuration file. The value is a language code. Do not translate locales and ignoredLocales, which are keys in the file."
    },
    "Add %@ to locales, or take it out of the group." : {
      "comment" : "Fix in the problem list. The value is a locale code, such as de-DE. Do not translate locales. It is a JSON key."
    },
    "Add %@ to locales, or take it out of the product." : {
      "comment" : "Fix in the problem list. The value is a language code. Do not translate locales, which is a JSON key. The word it refers to the language."
    },
    "Add %@ to the device classes, then add its screenshots." : {
      "comment" : "How to fix a missing device class. The value is a device class id, such as iphone-duo. Keep it as it is."
    },
    "Add %@ to the list, or delete the file. It will not be published." : {
      "comment" : "Fix in the problem list. The value is a language code. The list is the list of languages in the configuration file."
    },
    "Add %@ to the list, or delete the folder. It will not be published." : {
      "comment" : "Fix in the problem list. The value is a language code. The list is the list of languages in the configuration file."
    },
    "Add a \"why\" to the override. A price nobody can explain a year later is the one that goes wrong." : {
      "comment" : "Fix in the problem list. The override is a price that a person set by hand for one country. The word why is the name of a JSON key, and it stays in English."
    },
    "Add it to locales, or point sourceLocale at one that is there." : {
      "comment" : "Fix in the problem list. Do not translate locales or sourceLocale. They are JSON keys. The word it refers to the source language."
    },
    "Add it to locales, or take it out of usesSourceScreenshots." : {
      "comment" : "Fix in the problem list. Do not translate locales or usesSourceScreenshots. They are JSON keys. The word it refers to a language."
    },
    "Add subscriptionGroup. Every auto-renewable subscription belongs to one." : {
      "comment" : "Fix in the problem list. Do not translate subscriptionGroup. It is a JSON key."
    },
    "Add subscriptionPeriod, such as ONE_MONTH. ASCKit never writes it, and recording it lets a pull say when the store and the file disagree." : {
      "comment" : "Fix in the problem list. Do not translate subscriptionPeriod, ONE_MONTH or ASCKit. A pull is the action that reads App Store Connect."
    },
    "Add whichever of those the app is written for." : {
      "comment" : "Fix in the problem list. The word those refers to the language codes in the problem message."
    },
    "Added:" : {
      "comment" : "Heading in the report of what a push did. A list of added items comes after it."
    },
    "An app preview runs from %@ to %@." : {
      "comment" : "How to fix a video of the wrong length. The values are lengths, such as 15 seconds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An app preview runs from %1$@ to %2$@."
          }
        }
      }
    },
    "An empty value blanks the field on the store. Remove the field to leave it alone." : {
      "comment" : "Fix in the problem list. To blank a field is to make the field empty on the App Store."
    },
    "App Information" : {
      "comment" : "Noun. The name of one part of a publish, on its checkbox in the publish sheet and on its report. It is the text of the listing."
    },
    "App Information has no %@" : {
      "comment" : "Reason one language is left out of the publish plan. The value is a language code. App Information is the name of a tab in App Store Connect."
    },
    "App Review is done with the words of %@. The push makes a new draft of them, with a copy of the words there now, and changes the copy. Send the draft to review in App Store Connect." : {
      "comment" : "Paragraph in the publish plan. The value is a list of in-app purchase product ids or subscription group names, and they stay as they are. A draft is a new version of the words that App Review reads."
    },
    "App Store Connect did not make a new draft of this product's words. %@ Nothing was written in %@." : {
      "comment" : "Reason a push wrote nothing for one in-app purchase. The first value is what App Store Connect said, in English. The second is a list of language codes such as de-DE, en-US.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect did not make a new draft of this product's words. %1$@ Nothing was written in %2$@."
          }
        }
      }
    },
    "App Store Connect does not take %@ as a screenshot." : {
      "comment" : "Problem in a check. The value is a file name. Do not translate App Store Connect."
    },
    "App Store Connect does not take %@ as an app preview." : {
      "comment" : "Problem in a check. The value is a file name. Do not translate App Store Connect."
    },
    "App Store Connect does not take %@." : {
      "comment" : "Problem in a check. The value is a file name. Do not translate App Store Connect."
    },
    "App Store Connect does not take changes to %@ in its current state. Nothing in this slot changed after the refusal." : {
      "comment" : "Push failure. The value names a language and a device, such as en-US iphone-6.9. Do not translate App Store Connect."
    },
    "App Store Connect does not take these images in %@. Check that their size fits %@." : {
      "comment" : "Push failure. The first value is an App Store Connect group id, such as IPHONE_DUO_PROFILE. The second is a device class id, such as iphone-6.9. Do not translate App Store Connect.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect does not take these images in %1$@. Check that their size fits %2$@."
          }
        }
      }
    },
    "App Store Connect gave no equivalent price here" : {
      "comment" : "Reason in the publish plan that a country is not priced. There is no equivalent price from App Store Connect for this country. Do not translate App Store Connect."
    },
    "App Store Connect has no %@ page, and ASCKit never makes one. Add %@ in App Store Connect and read again, or ignore it in this project." : {
      "comment" : "Error when a push reaches a language App Store Connect has no page for. Both values are the same language code.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect has no %1$@ page, and ASCKit never makes one. Add %2$@ in App Store Connect and read again, or ignore it in this project."
          }
        }
      }
    },
    "App Store Connect has no asset library for this app, so ASCKit cannot read or write its screenshots. Open the app in App Store Connect once, then read again." : {
      "comment" : "Error when App Store Connect returns no asset library for the app."
    },
    "App Store Connect has no in-app purchase called %@, and ASCKit never makes one." : {
      "comment" : "Reason in the publish plan that an in-app purchase cannot be published. The value is a product id. Do not translate App Store Connect or ASCKit."
    },
    "App Store Connect has no page in %@, so nothing is written in those. Make the language there and read again, or ignore it with asckit ignore." : {
      "comment" : "Line in the publish plan, shown as fixed-width text. The value is a list of language codes. Do not translate asckit ignore, which is a command somebody types."
    },
    "App Store Connect has no subscription group called %@, and ASCKit never makes one." : {
      "comment" : "Reason in the publish plan that a subscription group cannot be written. The value is the reference name of the group."
    },
    "App Store Connect has not finished with %lld images. Read it again in a moment." : {
      "comment" : "Reason in the publish sheet that screenshots cannot be published yet. The count is the number of images that App Store Connect still processes.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "App Store Connect has not finished with %lld image. Read it again in a moment."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "App Store Connect has not finished with %lld images. Read it again in a moment."
                }
              }
            }
          }
        }
      }
    },
    "App Store Connect holds no draft of this product's words. Make one there, then push again. Nothing was written in %@." : {
      "comment" : "Reason a push wrote nothing for one in-app purchase. The value is a list of language codes such as de-DE, en-US."
    },
    "App Store Connect holds no words for %@ yet. Write the first ones there." : {
      "comment" : "Reason in the publish plan for words that cannot go. The value is an in-app purchase product id or a subscription group name, and it stays as it is."
    },
    "App Store Connect is on version %@, and there is no folder for it here." : {
      "comment" : "Reason in the publish sheet that a part cannot be published yet. The value is a version number. The folder is a version folder in the project on this Mac."
    },
    "App Store Connect is on version %@, and there is no folder for it. Make %@/%@ first." : {
      "comment" : "Error sentence when a person adds the languages from App Store Connect to the project. The first and the third values are the same version number. The second is the path of the versions folder.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect is on version %1$@, and there is no folder for it. Make %2$@/%3$@ first."
          }
        }
      }
    },
    "App Store Connect is on version %@, and there is no folder for it. The newest folder here is %@." : {
      "comment" : "Problem message in the problem list. The first value is the version number on App Store Connect. The second is the newest version number that has a folder in the project.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect is on version %1$@, and there is no folder for it. The newest folder here is %2$@."
          }
        }
      }
    },
    "App Store Connect is on version %@, and there is no folder for it. There are no version folders here yet." : {
      "comment" : "Problem message in the problem list. The value is the version number on App Store Connect. The folder is a version folder in the project."
    },
    "App Store Connect needs at least one. Put them in %@, or say this language shows the %@ ones." : {
      "comment" : "Fix in the problem list about a language with no screenshots. The first value is a folder path. The second is the language code of the source language. The word ones refers to screenshots.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect needs at least one. Put them in %1$@, or say this language shows the %2$@ ones."
          }
        }
      }
    },
    "App Store Connect needs at least one. Put them in %@. Every other language falls back to this one." : {
      "comment" : "Fix in the problem list about the source language with no screenshots. The value is a folder path. Do not translate App Store Connect."
    },
    "App Store Connect needs both a name and a description in every language." : {
      "comment" : "Fix in the problem list about an in-app purchase. The name and the description are the two text fields of an in-app purchase."
    },
    "App Store Connect needs both fields. Write something, or take the language out of the file." : {
      "comment" : "Fix in the problem list about an in-app purchase. The two fields are the name and the description. The file is the product file of the in-app purchase."
    },
    "App Store Connect needs iPhone Duo screenshots for every submission from April 2027." : {
      "comment" : "Warning in a check. Do not translate App Store Connect or iPhone Duo."
    },
    "App Store Connect refuses a submission without it." : {
      "comment" : "Fix in the problem list about a missing text field. The word it refers to the field. A submission is a version that a person sends to App Review."
    },
    "App Store Connect refuses it. Export it again without one. Artwork that looks fully opaque still gets an alpha channel from most design tools." : {
      "comment" : "Fix in the problem list about a screenshot with an alpha channel. Alpha channel is the transparency layer of an image. The words it and one refer to the alpha channel."
    },
    "App Store Connect sells in %@, and ASCKit's table does not list it. It gets Apple's own price." : {
      "comment" : "Problem message in the problem list. The value is a three-letter country code. The table is the list of countries that ASCKit knows. Do not translate App Store Connect, ASCKit or Apple."
    },
    "App Store Connect shows the %@ ones instead. Put %@ screenshots in %@." : {
      "comment" : "Fix in the problem list. The first value is the language code of the source language. The second is a language code, and the third is a folder path. The word ones refers to screenshots.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "App Store Connect shows the %1$@ ones instead. Put %2$@ screenshots in %3$@."
          }
        }
      }
    },
    "App Store Connect takes %lld to %lld frames a second." : {
      "comment" : "How to fix a video with the wrong frame rate. The two counts are the lowest and the highest frame rate. Do not translate App Store Connect.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store Connect takes %1$lld to %#@arg2@ a second."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg frame"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg frames"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "App Store Connect takes a file of at most %@." : {
      "comment" : "How to fix a video that is too big. The value is a file size, such as 500 MB. Do not translate App Store Connect."
    },
    "App Store Connect takes a file of at most %@. Export it smaller." : {
      "comment" : "How to fix a screenshot file that is too big. The value is a file size, such as 500 MB. Do not translate App Store Connect."
    },
    "App Store Connect takes no app preview for %@." : {
      "comment" : "Problem in a check. The value is a device name, such as Apple Watch Ultra. Do not translate App Store Connect."
    },
    "App Store Connect uses the three-letter code, USA and DEU, not the two-letter one." : {
      "comment" : "Fix in the problem list about a country code. Do not translate USA or DEU. They are country codes."
    },
    "App Store Connect wants one, even a silent one." : {
      "comment" : "How to fix a video with no sound track. Do not translate App Store Connect."
    },
    "App information file written for:" : {
      "comment" : "Heading in the report of the action that adds languages to the project. A list of language codes comes after it."
    },
    "App previews here are %@, or the same pair swapped." : {
      "comment" : "How to fix a video of the wrong size. The value is a list of sizes in pixels."
    },
    "App previews:" : {
      "comment" : "Heading in the publish plan, over the app preview sets that change."
    },
    "Apple equalized" : {
      "comment" : "Noun. The name of a price curve. A price curve is a set of rules that sets a price in each country. This curve uses the prices that Apple sets."
    },
    "Apple needs it for every version except the app's first. Leave it out only if this is the first." : {
      "comment" : "Fix in the problem list about the What's New text. The word it refers to the What's New text. The first refers to the first version of the app."
    },
    "Apple's own price everywhere. This is what App Store Connect does when you pick a price and save. Every other curve is measured against it." : {
      "comment" : "Description of the Apple equalized price curve, shown under its name. A curve is a set of rules that sets a price in each country. Do not translate App Store Connect."
    },
    "Archived in the library, because nothing shows them any more:" : {
      "comment" : "Heading in the push report. The lines under it name the old images and videos that a push took off the store and archived in the app's asset library."
    },
    "Auto-renewable subscription" : {
      "comment" : "Noun. The name of a kind of in-app purchase, as App Store Connect names it. It renews each period until the person stops it."
    },
    "Both have to be languages this project ships, and the same language, such as es-ES and es-MX. %@ has to be a device class it lists. Correct the entry, or take it out of copiesScreenshotsFrom." : {
      "comment" : "Fix in the problem list. Do not translate copiesScreenshotsFrom. It is a JSON key. The value is a device class identifier, such as ipad-13."
    },
    "Cannot be done now:" : {
      "comment" : "Heading in the publish plan, shown as fixed-width text. A list of changes that cannot be done now comes after it."
    },
    "Change bundleId, or open the folder holding the right Xcode project." : {
      "comment" : "Fix in the problem list. Do not translate bundleId. It is a JSON key. Do not translate Xcode."
    },
    "Check the locale against what asckit pull reports for this app." : {
      "comment" : "Fix in the problem list about a language code. Do not translate asckit pull. It is a command."
    },
    "Consumable" : {
      "comment" : "Noun. The name of a kind of in-app purchase, as App Store Connect names it. A person can buy it many times, and uses it up."
    },
    "Could not read %@: %@" : {
      "comment" : "Error sentence when the app cannot read a file. The first value is a file path. The second is the error text from the system.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read %1$@: %2$@"
          }
        }
      }
    },
    "Could not read %@: %@. Fix the file or move it away, and ASCKit finds the projects again." : {
      "comment" : "Error sentence when the file that records where each project is kept cannot be read. The first value is a file path. The second is the error text. Do not translate ASCKit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read %1$@: %2$@. Fix the file or move it away, and ASCKit finds the projects again."
          }
        }
      }
    },
    "Could not read project.xcproj or project.pbxproj in %@." : {
      "comment" : "Error sentence when the app opens an Xcode project. The value is the name of the Xcode project folder. Do not translate project.xcproj and project.pbxproj. They are file names."
    },
    "Could not write %@." : {
      "comment" : "Error when the app or the command line tool cannot write the private key file. The value is the file path."
    },
    "Create version %@ on App Store Connect, then pull the updates from there." : {
      "comment" : "Fix in the problem list. The value is a version number. Do not translate App Store Connect."
    },
    "Custom Product Pages" : {
      "comment" : "Noun. The name of one part of a publish, on its checkbox in the publish sheet and on its report. It is Apple's name for the extra product pages of an app in App Store Connect. Use the name that App Store Connect uses in your language."
    },
    "Custom app name" : {
      "comment" : "Noun. The name of a text field on a subscription group. It holds a name the App Store shows instead of the app's own name."
    },
    "Cut %lld characters." : {
      "comment" : "Fix in the problem list for text that is too long. The count is the number of characters to remove.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cut %lld character."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cut %lld characters."
                }
              }
            }
          }
        }
      }
    },
    "Description" : {
      "comment" : "Noun. The name of a text field in the listing and in an in-app purchase. It holds the long description."
    },
    "Display name" : {
      "comment" : "Noun. The name of a text field on a subscription group. It holds the name of the group that a customer reads."
    },
    "Emerging market push" : {
      "comment" : "Noun. The name of a price curve. A price curve is a set of rules that sets a price in each country. This curve sets much lower prices in countries with low income."
    },
    "Equal proceeds" : {
      "comment" : "Noun. The name of a price curve. A price curve is a set of rules that sets a price in each country. This curve makes the money that Apple pays you the same in each country."
    },
    "Every country goes in one request. A subscription has no price schedule. It takes an update that carries every country instead. ASCKit sends them all, whether or not they change. Apple does not say whether an update replaces the set or adds to it." : {
      "comment" : "Paragraph in the publish plan under the prices of a subscription, shown as fixed-width text. A price schedule is a list of prices with start dates. Do not translate ASCKit or Apple."
    },
    "Every language App Store Connect holds is already in this project." : {
      "comment" : "Message when a person adds the languages from App Store Connect to the project. No language is new."
    },
    "Every space costs a character of the 100. Separate with commas alone." : {
      "comment" : "Fix in the problem list about the keywords. The keywords field has a limit of 100 characters."
    },
    "Everything in this folder is uploaded. Remove the file or replace it." : {
      "comment" : "Fix in the problem list about a screenshot that the app cannot open. The push uploads all files in the screenshot folder."
    },
    "Export it again as one movie." : {
      "comment" : "How to fix a fragmented video."
    },
    "Export it again without one." : {
      "comment" : "How to fix an image with an alpha channel."
    },
    "Export it as %@." : {
      "comment" : "How to fix a screenshot of the wrong file type. The value is a list of file types, such as .png or .jpg."
    },
    "Export it as H.264, or as ProRes 422 HQ in a .mov file." : {
      "comment" : "How to fix a video with a codec App Store Connect does not take. Do not translate H.264 or ProRes 422 HQ."
    },
    "Export it as png, jpg, mov, mp4 or m4v." : {
      "comment" : "How to fix a file of the wrong type. Keep the file types as they are."
    },
    "Export it at 30 or 60 frames a second." : {
      "comment" : "How to fix a video with the wrong frame rate."
    },
    "Failed:" : {
      "comment" : "Heading in the report of what a push did. A list of items that failed comes after it."
    },
    "Filled from App Store Connect:" : {
      "comment" : "Heading in the report after a read fills empty fields. One line per language follows, with the names of the fields that changed."
    },
    "Fix the JSON, or take the file out." : {
      "comment" : "Fix in the problem list about a product file that the app cannot read. Do not translate JSON."
    },
    "Four steps by income, from the base price converted down to a third of it. The shape a consumer subscription uses when it wants volume in large lower-income markets." : {
      "comment" : "Description of the Purchasing power price curve, shown under its name. The four steps are four groups of countries by income."
    },
    "Give it an amount, a price point, or skip. Otherwise take it out and let the curve decide." : {
      "comment" : "Fix in the problem list about a price set by hand for one country. Do not translate skip. It is a JSON key. The curve is the price curve of the product."
    },
    "Header and search results:" : {
      "comment" : "Heading in the publish plan, over the product page header and search results art that changes."
    },
    "Here App Store Connect takes %@, in the file types each size allows." : {
      "comment" : "How to fix art of the wrong size. The value is a list of sizes in pixels. Do not translate App Store Connect."
    },
    "In-App Purchases" : {
      "comment" : "Noun. The name of one part of a publish, on its checkbox in the publish sheet and on its report. It is the text of the in-app purchases."
    },
    "In-app purchases:" : {
      "comment" : "Heading in the publish plan, shown as fixed-width text. A list of in-app purchase text changes comes after it."
    },
    "It has to map each file name to a time code, such as {\"01-a.mov\": \"00:00:05:00\"}." : {
      "comment" : "How to fix a damaged poster-frames.json. Keep the example as it is."
    },
    "Keep one. An amount is rounded up to a real point, and a point is taken as it is." : {
      "comment" : "Fix in the problem list about a price set by hand. A point is a price point, which is one fixed price on the list of prices of the App Store."
    },
    "Keep one. App Store Connect shows one." : {
      "comment" : "How to fix two files for the header, or two for search results. Do not translate App Store Connect."
    },
    "Keywords" : {
      "comment" : "Noun. The name of the keywords field of the listing."
    },
    "Left alone, already listed:" : {
      "comment" : "Heading in a report. A list of device classes that the project already lists comes after it. The app did not change them."
    },
    "Left alone, already there:" : {
      "comment" : "Heading in a report. A list of items that were already in the project comes after it. The app did not change them."
    },
    "Left as they were:" : {
      "comment" : "Heading in the report of the action that removes the alpha channel from screenshots. A list of files that the app could not change comes after it."
    },
    "Left out:" : {
      "comment" : "Heading in the publish plan, shown as fixed-width text. A list of languages or in-app purchases that the push does not publish comes after it."
    },
    "Left out: %@" : {
      "comment" : "Line in the publish plan under the prices of one product, shown as fixed-width text. The value is a list of country codes that the push does not price."
    },
    "Made %@/%@ from App Store Connect." : {
      "comment" : "First line of the report after the app makes a folder for a new version, shown as fixed-width text. The first value is the versions folder name. The second is the version number.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Made %1$@/%2$@ from App Store Connect."
          }
        }
      }
    },
    "Make %@/%@ and write the app information for that version." : {
      "comment" : "Fix in the problem list. The first value is the path of the versions folder. The second is a version number. The result is a folder path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Make %1$@/%2$@ and write the app information for that version."
          }
        }
      }
    },
    "Make %@/<version>/%@ and put an app information file in it." : {
      "comment" : "Fix in the problem list. The first value is the path of the versions folder, and the second is a folder name. Do not translate <version>, which holds the place of a version number.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Make %1$@/<version>/%2$@ and put an app information file in it."
          }
        }
      }
    },
    "Marketing URL" : {
      "comment" : "Noun. The name of the marketing URL field of the listing. URL is a web address."
    },
    "Moved to the Trash, because App Store Connect has no such group:" : {
      "comment" : "Heading in a report. A list of subscription group files comes after it. App Store Connect holds no group with the name of each file, so the app moved the file to the Trash."
    },
    "Moved to the Trash, because App Store Connect never released these versions:" : {
      "comment" : "Heading in a report. A list of version folders comes after it, such as versions/1.16. App Store Connect never released those versions, so the app moved the folders to the Trash."
    },
    "Moved to the Trash, because the language shows the source language's:" : {
      "comment" : "Heading in the push report. The lines under it name image files, such as en-AU/header.png. Each language is set to show the screenshots and art of the source language, so the push moved its own files to the Trash."
    },
    "Name" : {
      "comment" : "Noun. The name of a text field in the listing and in an in-app purchase. It holds the name of the app or of the in-app purchase."
    },
    "Name it header or search-results, with its extension. Nothing uploads it." : {
      "comment" : "How to fix a file in the creative folder with an unknown name. Keep header and search-results as they are: they are file names."
    },
    "No change." : {
      "comment" : "Short line under the name of a part in the publish sheet. The part has nothing to publish."
    },
    "No changes." : {
      "comment" : "Summary of the publish plan when there is nothing to publish."
    },
    "No configuration file at %@. A project needs an %@." : {
      "comment" : "Error sentence when the app opens a project. The first value is a folder path. The second is the configuration file name, which stays in English.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No configuration file at %1$@. A project needs an %2$@."
          }
        }
      }
    },
    "No device classes are listed, so no screenshots will be published." : {
      "comment" : "Problem message in the problem list. A device class is a group of devices with the same screenshot size, such as iPhone 6.9 inch."
    },
    "No languages are listed, so there is nothing to publish." : {
      "comment" : "Problem message in the problem list about the configuration file."
    },
    "No private key for %@. Looked in:\n%@\n\nMake a key in App Store Connect, under Users and Access, Integrations, with the App Manager role. Then:\n\n  mkdir -p %@\n  mv ~/Downloads/%@ %@/\n  chmod 600 %@/%@\n\nOr point %@ at the file." : {
      "comment" : "Error text from the command line tool when it finds no App Store Connect API key. Keep every line break. The values are a key id, folder paths, a file name and an environment variable name. Do not translate the command lines, or Users and Access, Integrations and App Manager.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No private key for %1$@. Looked in:\n%2$@\n\nMake a key in App Store Connect, under Users and Access, Integrations, with the App Manager role. Then:\n\n  mkdir -p %3$@\n  mv ~/Downloads/%4$@ %5$@/\n  chmod 600 %6$@/%7$@\n\nOr point %8$@ at the file."
          }
        }
      }
    },
    "Non-consumable" : {
      "comment" : "Noun. The name of a kind of in-app purchase, as App Store Connect names it. A person buys it one time and keeps it."
    },
    "Non-renewing subscription" : {
      "comment" : "Noun. The name of a kind of in-app purchase, as App Store Connect names it. It gives access for a fixed time and does not renew."
    },
    "Not used, because the language shows the source language's. A push moves them to the Trash:" : {
      "comment" : "Heading in the publish plan. The lines under it name image files of languages that are set to show the screenshots and art of the source language."
    },
    "Not ready to publish." : {
      "comment" : "Last part of the summary of the problem list. It shows when there is one error or more."
    },
    "Nothing has been read yet. Read App Store Connect first." : {
      "comment" : "Reason in the publish sheet that a part cannot be published yet. Do not translate App Store Connect."
    },
    "Nothing here. ASCKit needs the territory added to its own table." : {
      "comment" : "Fix in the problem list about a country that ASCKit does not know. There is nothing that a person can do. The table is the list of countries in ASCKit."
    },
    "Nothing in it is pushed until it reads." : {
      "comment" : "Fix for a custom product page file that does not read. It says that nothing in the file goes to App Store Connect."
