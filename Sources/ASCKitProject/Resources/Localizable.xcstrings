            }
          }
        }
      }
    },
    "The %@ numbers were taken on %@, which is over a year ago." : {
      "comment" : "Problem message in the problem list. The first value is a price curve id, such as purchasing-power. The second is a date, such as 2025-01-15. The numbers are the income data that the curve uses.",
      "localizations" : {
