    "%@ has an alpha channel." : {
      "comment" : "Short reason in the list of screenshots that the app refuses. The value is a file name. Alpha channel is the transparency layer of an image. Do not translate App Store Connect."
    },
    "%@ has an alpha channel. App Store Connect refuses those. Export it again without one. Artwork that looks fully opaque still gets an alpha channel from most design tools." : {
      "comment" : "Reason in the list of screenshots that the app refuses. The value is a file name. Alpha channel is the transparency layer of an image. Do not translate App Store Connect."
    },
    "%@ has more previews than App Store Connect takes. The limit is %lld." : {
