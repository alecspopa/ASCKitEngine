{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "A value that the app shows as it is. It holds a product id, or a reason that a person or the JSON reader wrote. Keep only the placeholder."
    },
    "%@  %@  %@ to %@  %@" : {
      "comment" : "One row of the price list in the publish plan, in a fixed-width font. The values are a country code, the length of the plan, the old price, the new price, and a direction such as up or down. Each price already has its currency, such as $12.13.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  %2$@  %3$@ to %4$@  %5$@"
          }
        }
      }
    },
    "%@ %@ in %@ matches %@." : {
      "comment" : "Problem message in the problem list, about an in-app purchase. The first value is a product id. The second is a field name such as name or description, and it stays in English. The third and the fourth are language codes.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ in %3$@ matches %4$@."
          }
        }
      }
    },
    "%@ %@ inch" : {
      "comment" : "The name of a device class for screenshots, such as iPhone 6.9 inch. The first value is a device family such as iPhone or iPad. The second is the screen size in inches. Translate only the word inch.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ inch"
          }
        }
      }
    },
    "%@ %@ matches %@." : {
      "comment" : "Problem message in the problem list. The first value is a language code. The second is a JSON field name such as whatsNew, and it stays in English. The third is the language code of the source language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ matches %3$@."
          }
        }
      }
    },
    "%@ %@: placing %lld images" : {
      "comment" : "Progress line while a push makes new placements. The values are the language, the device class ID and the count of images placed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: placing %#@arg3@"
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg image"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg images"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ %@: removing %lld images" : {
      "comment" : "Progress line while a push runs. The first value is a language code. The second is a device class name. The count is the number of images.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@: removing %#@arg3@"
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg image"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg images"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ %@: setting the order" : {
      "comment" : "Progress line while a push runs. The first value is a language code. The second is a device class name. The app sets the order of the uploaded screenshots.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@: setting the order"
          }
        }
      }
    },
    "%@ %@: uploading %@" : {
      "comment" : "Progress line while a push runs. The first value is a language code. The second is a device class name. The third is a file name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@: uploading %3$@"
          }
        }
      }
    },
    "%@ Affects %@." : {
      "comment" : "Line in the publish plan and in the publish sheet about a change that cannot be done. The first value is a full sentence that gives the reason. The second value is the thing that the reason stops, such as a product id or a count of changes.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ Affects %2$@."
          }
        }
      }
    },
    "%@ Affects %@. And %lld more." : {
      "comment" : "Line in the publish sheet about changes that cannot be done. The first value is a full sentence that gives the reason. The second value is the thing that the reason stops. The count is the number of other reasons.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Affects %2$@. And %#@arg3@ more."
          },
          "substitutions" : {
            "arg3" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ already holds %lld screenshots. Adding %lld would pass the limit of %lld. Remove some first." : {
      "comment" : "Error sentence when a person adds screenshots to a set. The first value is a device class id. The first count is the screenshots in the set. The second count is the new screenshots, and the third count is the limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ already holds %#@arg2@. Adding %3$lld would pass the limit of %4$lld. Remove some first."
          },
          "substitutions" : {
            "arg2" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg screenshot"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg screenshots"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ also goes into search results, because this language has no search results file. Only a universal image fits both." : {
      "comment" : "Problem in a check. The value is the header file name."
    },
    "%@ and %@ are different languages, so the pictures say different words. Screenshots are copied only between languages such as es-ES and es-MX. To show another language's screenshots, put %@ in usesSourceScreenshots." : {
      "comment" : "Error sentence when a person copies screenshots between languages. The first and the second values are language codes. Do not translate es-ES, es-MX or usesSourceScreenshots. usesSourceScreenshots is a JSON key.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ are different languages, so the pictures say different words. Screenshots are copied only between languages such as es-ES and es-MX. To show another language's screenshots, put %3$@ in usesSourceScreenshots."
          }
        }
      }
    },
    "%@ app preview" : {
      "comment" : "Short text in the publish plan, shown as fixed-width text. The value is a device class name, such as iPhone 6.9\". A file name of an app preview video comes after it."
    },
    "%@ asks for %@ in %@, and the most the store sells for there is %@." : {
      "comment" : "Problem message in the problem list, about a price. The first value is a product id, and the second is a price. The third is a country code. The fourth is the highest price the store sells in that country.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ asks for %2$@ in %3$@, and the most the store sells for there is %4$@."
          }
        }
      }
    },
    "%@ asks for a price curve called %@." : {
      "comment" : "Problem message in the problem list. The first value is a product id. The second is the name of a price curve that ASCKit does not know. A price curve is a set of rules that sets a price in each country.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ asks for a price curve called %2$@."
          }
        }
      }
    },
    "%@ builds nothing the App Store lists." : {
      "comment" : "Error sentence when a person makes a new project from an Xcode project. The value is the Xcode project name. Do not translate App Store."
    },
    "%@ builds version %@, but there is no version %@ on App Store Connect." : {
      "comment" : "Problem message in the problem list. The first value is the Xcode project file name. The second and third values are the same version number. Do not translate App Store Connect.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ builds version %2$@, but there is no version %3$@ on App Store Connect."
          }
        }
      }
    },
    "%@ cannot be %@ in %@: no instalment there works out between a twelfth and an eighth of it." : {
      "comment" : "Problem message in the problem list, about a yearly price paid in 12 monthly instalments. The first value is a product id. The second is a price, and the third is a country code.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ cannot be %2$@ in %3$@: no instalment there works out between a twelfth and an eighth of it."
          }
        }
      }
    },
    "%@ cannot be a product id. %@" : {
      "comment" : "Error sentence when a person names a new in-app purchase. The first value is the product id that the person typed. The second value is a full sentence that gives the reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ cannot be a product id. %2$@"
          }
        }
      }
    },
    "%@ cannot be a subscription group name. %@" : {
      "comment" : "Error when a subscription group file cannot be written. The first value is the group name. The second value is the reason, as a full sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ cannot be a subscription group name. %2$@"
          }
        }
      }
    },
    "%@ cannot copy its own screenshots." : {
      "comment" : "Error sentence when a person copies screenshots between languages. The value is a language code. The language cannot copy screenshots to itself."
    },
    "%@ could not be drawn again without its alpha channel." : {
      "comment" : "Error sentence when the app removes the transparency layer from an image. The value is a file name. Alpha channel is the transparency layer of an image."
    },
    "%@ could not be read as a movie." : {
      "comment" : "Problem in a check. The value is a video file name."
    },
    "%@ could not be read as an image." : {
      "comment" : "Error sentence and problem message in the problem list. The value is a file name. The file is a screenshot that the app cannot open."
    },
    "%@ could not be read." : {
      "comment" : "Problem in a check. The value is a file name."
    },
    "%@ could not be written again without its alpha channel." : {
      "comment" : "Error sentence when the app removes the transparency layer from an image. The value is a file name. Alpha channel is the transparency layer of an image."
    },
    "%@ did not upload." : {
      "comment" : "Push failure. The value is a screenshot file name."
    },
    "%@ did not upload. %@" : {
      "comment" : "Push failure. The first value is a screenshot file name. The second is the reason, in a sentence of its own.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ did not upload. %2$@"
          }
        }
      }
    },
    "%@ does not look like a private key. Apple's file is named AuthKey_<KEY_ID>.p8 and starts with BEGIN PRIVATE KEY." : {
      "comment" : "Error message when a person chooses a private key file. The value is the name of the chosen file. Do not translate AuthKey_<KEY_ID>.p8 or BEGIN PRIVATE KEY."
    },
    "%@ does not read: %@" : {
      "comment" : "Problem message in the problem list. The first value is a file path in the custom product pages folder. The second value is the error text from the JSON reader, in English.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ does not read: %2$@"
          }
        }
      }
    },
    "%@ does not say which device it is for. Name it like %@. This project lists %@." : {
      "comment" : "Error sentence about the name of a screenshot file that a person adds. The first value is a file name. The second is an example file name. The third is a list of device class ids.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not say which device it is for. Name it like %2$@. This project lists %3$@."
          }
        }
      }
    },
    "%@ does not say which language it is for. Name it like %@." : {
      "comment" : "Reason in the list of inbox images that the app refuses. The first value is a file name. The second value is an example file name for a header image. Keep the example as it is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ does not say which language it is for. Name it like %2$@."
          }
        }
      }
    },
    "%@ does not start with a number." : {
      "comment" : "Problem message in the problem list. The value is a screenshot file name. The number at the start of the name sets the order of the screenshots."
    },
    "%@ ends with \"%@\", which is not a language. Name it like %@." : {
      "comment" : "Error sentence about the name of a screenshot file that a person adds. The first value is a file name. The second is the last part of that name. The third is an example file name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ ends with \"%2$@\", which is not a language. Name it like %3$@."
          }
        }
      }
    },
    "%@ has %@ frames a second." : {
      "comment" : "Problem in a check. The first value is a video file name. The second is its frame rate, such as 60.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$@ frames a second."
          }
        }
      }
    },
    "%@ has %@." : {
      "comment" : "Problem in a check. The first value is a folder path. The second is a list of file names.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has %2$@."
