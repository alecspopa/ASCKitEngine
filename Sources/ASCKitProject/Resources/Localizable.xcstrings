    "What every in-app purchase costs in every country." : {
      "comment" : "Help text for the Prices checkbox in the publish sheet."
    },
    "What's New" : {
      "comment" : "Noun. The name of the What's New field of the listing. It holds the text about the changes in this version."
    },
    "Would change %@." : {
